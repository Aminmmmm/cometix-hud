{
  "name": "cometix-hud",
  "version": "1.0.0",
  "description": "Fusion statusline for Claude Code \u2014 CCometixLine aesthetics + Claude HUD functionality",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "src/",
    "commands/",
    ".claude-plugin/",
    "bin/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=lcov node --test",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 npm test",
    "test:stdin": "npm run build && echo '{\"model\":{\"display_name\":\"Opus\"},\"context_window\":{\"current_usage\":{\"input_tokens\":45000},\"context_window_size\":200000},\"transcript_path\":\"/tmp/test.jsonl\"}' | node dist/index.js"
  },
  "keywords": [
    "claude-code",
    "statusline",
    "hud",
    "powerline",
    "nerd-font",
    "cometix"
  ],
  "author": "Amin",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "c8": "^11.0.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aminmmmm/cometix-hud.git"
  },
  "homepage": "https://github.com/Aminmmmm/cometix-hud#readme",
  "bugs": {
    "url": "https://github.com/Aminmmmm/cometix-hud/issues"
  },
  "bin": {
    "cometix-hud": "./bin/cometix-hud.mjs"
  }
}
